# Copy to .env for local use, or set these in your hosting dashboard.
# Nothing here is required to build, but SITE_URL must be set for deployment.

# Public production URL, no trailing slash. Used for canonical URLs, sitemap and social tags.
# Defaults to the siteUrl in site.config.json (https://promptrin.com). Only set this to override it.
# SITE_URL=https://promptrin.com

# Optional: override the brand name from site.config.json
# BRAND_NAME=Promptrin

# Contact page (use either or both). Leave blank until you have real details.
CONTACT_EMAIL=
CONTACT_FORM_ACTION=

# Optional: name shown as Article author in structured data. Leave blank unless it is a real author.
AUTHOR_NAME=

# Social links (https URLs only; blank = not shown)
SOCIAL_INSTAGRAM=
SOCIAL_PINTEREST=
SOCIAL_YOUTUBE=
SOCIAL_X=
SOCIAL_FACEBOOK=

# Google AdSense. Leave blank to keep all ad code disabled.
# Only fill these in after you have an approved AdSense account. Never invent IDs.
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_HOME=
ADSENSE_SLOT_CATEGORY=
ADSENSE_SLOT_PROMPT=
# Set to false to switch ads off without deleting the IDs
# ADS_ENABLED=false
